# Frontend env (Vite — only VITE_* vars reach the browser; never put secrets here).

# LoanRegistry — the seam (deploy via contracts/script/Deploy.s.sol, then paste the address).
VITE_LOAN_REGISTRY_ADDRESS=

# LoanVault on Arc (Stage 2). Used for the borrower's claim() call.
VITE_LOAN_VAULT_ADDRESS=

# ERC-20 USDC on Arc (6 decimals) — look up via the Circle MCP server / address page
# (https://developers.circle.com/stablecoins/usdc-contract-addresses). NEVER hardcode (Golden Rule #5).
VITE_USDC_ADDRESS=

# Optional RPC override; otherwise viem's built-in Arc Testnet RPC is used.
VITE_ARC_RPC_URL=
