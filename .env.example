# ── Arc (Circle L1) — TESTNET ONLY, chain id 5042002 (Golden Rule #3) ──────────────
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
DEPLOYER_PRIVATE_KEY=
# USDC on Arc — DO NOT hardcode in code (Golden Rule #5). Look up via the Circle MCP server
# or https://developers.circle.com/stablecoins/usdc-contract-addresses, then paste here.
USDC_ADDRESS=
EURC_ADDRESS=

# ── CCTP V2 (cross-chain USDC; Golden Rule #6) — Arc Testnet, domain 26 ───────────────
CCTP_DOMAIN_ARC=26
CCTP_TOKEN_MESSENGER_V2=
CCTP_MESSAGE_TRANSMITTER_V2=

# ── Gateway (unified multi-chain balance for lender deposits) — Arc Testnet, domain 26 ─
GATEWAY_WALLET=
GATEWAY_MINTER=

# ── Circle ──────────────────────────────────────────────────────────────────────────
CIRCLE_API_KEY=                 # testnet key from developers.circle.com console

# ── World (identity + ZK) — docs/05 ───────────────────────────────────────────────────
WORLD_APP_ID=
WORLD_ACTION_ID=                # e.g. "mint-credit-passport"
WORLD_ID_VERIFIER_ADDRESS=      # on-chain verifier used by PassportRegistry

# ── Chainlink CRE (decision layer) — docs/04 ──────────────────────────────────────────
CRE_WORKFLOW_NAME=vouch-underwriter
CONFIDENTIAL_AI_API_URL=        # sandbox endpoint from the Confidential AI track
CONFIDENTIAL_AI_API_KEY=
LOAN_REGISTRY_ADDRESS=          # deployed on Arc (output of contracts/script/Deploy.s.sol)
CRE_FORWARDER_ADDRESS=          # set as authorized writer on LoanRegistry via setForwarder()
